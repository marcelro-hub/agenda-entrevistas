# Variables de entorno — copiar este archivo como .env y completar los valores
# NO subir el archivo .env a GitHub

# Cadena de conexión a PostgreSQL (ej: Supabase → Project Settings → Database →
# Connection string → modo "Transaction pooler", recomendado para funciones serverless)
DATABASE_URL=postgresql://user:password@host:6543/postgres

NODE_ENV=production
PORT=3000
